# Copy values into the process environment; the app does not auto-load this file.
HACKALEM_ACCESS_TOKEN=replace-with-a-private-access-code
HACKALEM_SECURE_COOKIE=1
HACKALEM_DEVICE=cuda
# Shared generation budget for extraction and its optional JSON repair (seconds).
HACKALEM_LLM_TIMEOUT_SECONDS=240
# HACKALEM_DATA_DIR=/home/ubuntu/workspace/hackalem-ai/data
# HACKALEM_MODEL_DIR=/home/ubuntu/workspace/hackalem-ai/models
HACKALEM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
